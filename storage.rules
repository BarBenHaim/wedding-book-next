rules_version = '2';

// Storage security rules — currently the only client-side storage use
// is uploading guest photos to weddings/{weddingId}/{entryId}.jpg.
// Reads are public (the gallery + book pages need to render them).

service firebase.storage {
  match /b/{bucket}/o {

    // Guest photos under each wedding folder.
    match /weddings/{weddingId}/{filename} {
      // Anyone can view a wedding's photos (gallery + viewer book).
      allow read: if true;

      // Anyone can upload — the photo flow doesn't authenticate
      // guests. Cap size at 8 MB and only accept images so the
      // bucket can't become a malware host.
      allow create: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      // No client-side mutation or deletion. Admin SDK handles those.
      allow update, delete: if false;
    }

    // Studio backgrounds uploaded via the design studio (super-admin /
    // signed-in user uploads through the picker). Reads are public so
    // every wedding's book can render them. Writes require auth.
    match /studio/backgrounds/{filename} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null
        && (request.resource == null
            || (request.resource.size < 8 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Media the bot sends on WhatsApp, uploaded from /admin/sales-leads.
    // The file goes browser -> Storage directly because a 16 MB video
    // through a serverless function hits the request body limit; only
    // the resulting URL is posted to the API, which is where the real
    // authorisation check lives (super-admin ID token).
    //
    // Reads are public because WhatsApp's servers fetch the URL to
    // deliver the message, unauthenticated. Writes need a signed-in
    // user, and the ceilings mirror WhatsApp's own limits so a file
    // that would fail at send cannot be stored in the first place.
    match /sales-media/{filename} {
      allow read: if true;
      allow create:
        if request.auth != null
        && ((request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024)
            || (request.resource.contentType.matches('video/.*')
                && request.resource.size < 16 * 1024 * 1024));
      allow update, delete: if false;
    }

    // Anything else — admin SDK only.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
