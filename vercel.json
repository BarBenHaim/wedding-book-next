{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "assist",
          "format": "url",
          "env": "BLESSING_ASSIST_URL"
        }
      ]
    },
    "assist": {
      "root": "blessing-assist-service/",
      "framework": "flask",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "excludeFiles": "{tests/**,**/test_*.py,prompt_lab.py,experiments.md,README.md,Procfile}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/cron/email", "schedule": "0 8 * * *" },
    { "path": "/api/cron/sales-model-status", "schedule": "15 8 * * *" },
    { "path": "/api/cron/sales-model-status", "schedule": "15 18 * * *" },
    { "path": "/api/sales-agent/followups", "schedule": "30 7 * * *" },
    { "path": "/api/sales-agent/followups", "schedule": "30 15 * * *" }
  ]
}
