# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / temp syntax-check files (created in-session; OneDrive blocks unlink)
_chk.cjs
_chk*.cjs

# vitest temp configs — vitest writes a compiled copy of vitest.config.mjs
# next to it on every run and normally deletes it on exit; when the run
# happens through the OneDrive mount the unlink is blocked, so the husks
# pile up. Never commit them.
vitest.config.mjs.timestamp-*

# Screens removed from the super-admin, parked here because the
# OneDrive mount blocks unlink. Safe to delete by hand.
_to_delete/

# Local isolated worktrees used during feature development.
.worktrees/

.vercel
